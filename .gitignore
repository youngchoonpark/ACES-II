# Compiled objects / libraries / archives
*.a
*.o
*.so
*.tar
/bin
/lib

# Build outputs and logs (compile/run artifacts, not source)
*.output
*.error
*.log
*.stdout
*.stderr

# Editor swap files
*.swp
*.swo
*~

# Fortran compiler-emitted module files
*.mod

# NOTE: *.f is intentionally NOT ignored. Most untracked lowercase *.f are
# generated by preprocessing *.F, but some *.f are genuine hand-written
# source. Do not blanket-ignore them; handle generated *.f case by case.
