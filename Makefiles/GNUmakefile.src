# Local build configuration for this checkout.
#
# ARCH/OPSYS/CMPLR are auto-detected by GNUmakefile when the host is not in
# the MACHSTATS table (here: gnu / X86_64 / linux). The original developer
# (QTP) configuration is preserved in GNUmakefile.src.example for reference.
#
# This file is per-checkout: keep machine/user-specific absolute paths OUT of
# it so the tree stays portable. Override anything here or on the command line.

# Functional feature defines for the intended ACES II build.
# NOTE: _DEBUG_LVL0 is intentionally OFF. It activates verbose debug
# instrumentation across the tree (e.g. trp/trps2.F calls check_t2/check_t2grd
# diagnostics that read gradient lists not present in an energy-only CCSD(T)
# run -> @GETLST "List does not exist" crash). The reference outputs are quiet
# production runs; keep it off so runtime behavior matches.
DEFINES_EXTRA = -D_ASSERT -D_DOUG_KROLL -D_TDENS -D_MKLST -D_GETPTS \
                -D_DPOCC -D_RCC

OPTIMIZE = 1
DEBUG    = 0
# 64BIT=0 so F_64BIT is NOT defined -> C f_int is 4-byte int (iintln=4,
# iintfp=2), consistent with the 4-byte Fortran default integer. Addresses
# remain 8-byte (the gnu branch defines -DF_ADR=integer*8 unconditionally).
64BIT    = 0

# MARCH selects the CPU target (default: native to the build host).
# Set MARCH = x86-64 for portable binaries.
# MARCH = native

INCDIRS = ../include ../include/mpi ./include \
          ../intgrt/include/ ../sbtools/include

# Link against the numerical libraries ACES builds into ./lib and ../lib
# (resolved via the default -L./lib -L../lib search path -- no absolute paths).
LDFLAGS_NUMLIBS := -llinpack -leispack -llb

# Install targets within this checkout. DIR_INSTBIN/DIR_INSTLIB default to
# ../bin and ../lib (relative -> portable), so they are intentionally unset.

###################################
## AME and ASL specific settings ##
###################################

ifeq (${CURR},asv)
   LIST_DEF_LIBS :=
   ACES_LINK_LISTS :=
   LD := $(filter-out -c,${CC})
   LDFLAGS := ${CFLAGS}
   LDFLAGS_EXTRA := ../joda/asv_ctl.o
   LDFLAGS_NUMLIBS :=
endif

# extiface (external-program interfaces: NWChem, GAMESS, ...) uses Fortran 90
# modules; FAST mode does not compute module dependencies, so compile the
# providers before their users (topological order):
#   mod_fun/mod_print -> mod_get_aces2,mod_civec,mod_info,mod_movec -> mod_aovec
#   -> mod_job -> extiface.
ifeq (${CURR},extiface)
   OBJ := function.o print.o get_aces2.o civec.o nwchem_info.o movec.o \
          aovec.o civec2.o job.o extiface.o
endif

# get_acesmo has the same F90-module dependency: main.F90 (program get_acesmo)
# `use mod_movec` (movec.F90) and `use mod_info` (nwchem_info.F90). FAST mode
# does not compute module deps, so compile the providers before main.o, else a
# cold build fails with a missing mod_movec.mod/mod_info.mod.
ifeq (${CURR},get_acesmo)
   OBJ := aces_info.o nwchem_info.o movec.o print.o main.o
endif
