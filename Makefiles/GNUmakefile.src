# Local build configuration for this checkout.
#
# ARCH/OPSYS/CMPLR are auto-detected by GNUmakefile when the host is not in
# the MACHSTATS table (here: gnu / X86_64 / linux). The original developer
# (QTP) configuration is preserved in GNUmakefile.src.example for reference.
#
# This file is per-checkout: keep machine/user-specific absolute paths OUT of
# it so the tree stays portable. Override anything here or on the command line.

# Functional feature defines for the intended ACES II build.
# (-D_DEBUG_LVL0 enables verbose debug printing; remove for quiet runs.)
DEFINES_EXTRA = -D_ASSERT -D_DOUG_KROLL -D_TDENS -D_MKLST -D_GETPTS \
                -D_DPOCC -D_RCC -D_DEBUG_LVL0

OPTIMIZE = 1
DEBUG    = 0
64BIT    = 1

# MARCH selects the CPU target (default: native to the build host).
# Set MARCH = x86-64 for portable binaries.
# MARCH = native

INCDIRS = ../include ../include/mpi ./include \
          ../intgrt/include/ ../sbtools/include

# Link against the numerical libraries ACES builds into ./lib and ../lib
# (resolved via the default -L./lib -L../lib search path -- no absolute paths).
LDFLAGS_NUMLIBS := -llinpack -leispack -llb

# Install targets within this checkout. DIR_INSTBIN/DIR_INSTLIB default to
# ../bin and ../lib (relative -> portable), so they are intentionally unset.

###################################
## AME and ASL specific settings ##
###################################

ifeq (${CURR},asv)
   LIST_DEF_LIBS :=
   ACES_LINK_LISTS :=
   LD := $(filter-out -c,${CC})
   LDFLAGS := ${CFLAGS}
   LDFLAGS_EXTRA := ../joda/asv_ctl.o
   LDFLAGS_NUMLIBS :=
endif
